# =====================================================
# ProofPay Frontend Configuration
# =====================================================
# Copy this file to .env.local and fill in your values

# Backend API URL (default: http://127.0.0.1:8010)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8010

# USDT0 contract address on Flare
# Mainnet: 0x0B38e83B86d491735fEaa0a791F65c2B99535396
NEXT_PUBLIC_USDT0_ADDRESS=0x0B38e83B86d491735fEaa0a791F65c2B99535396

# Chain ID (Mainnet: 14, Coston2 Testnet: 114)
NEXT_PUBLIC_CHAIN_ID=14

# Flare RPC URL for wallet connection
NEXT_PUBLIC_FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc
